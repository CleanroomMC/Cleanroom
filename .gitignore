hs_err_pid*
replay_pid*
*.hprof
*.jfr
*.log

# Minecraft Development
run/
!**/src/**/run/
logs/
!**/src/**/logs/
crash-reports/
.mixin.out/

# OS noise
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

