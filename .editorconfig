# Managed by CleanroomMC/Conventions. Do not edit locally.
# Change it there and bump the convention plugin version instead.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 160

[*.{java,gradle,groovy,kt,kts}]
indent_size = 4

[*.{json,json5,yml,yaml,toml,xml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[{Makefile,*.mk}]
indent_style = tab

[*.{bat,cmd}]
end_of_line = crlf

[gradlew]
end_of_line = lf
