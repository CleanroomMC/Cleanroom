+    public com.cleanroommc.component.DataComponentMap getComponents() {
+        com.cleanroommc.component.DataComponentMap built = this.components;
+        if (built == null) {
+            com.cleanroommc.component.DataComponentMap.Builder builder = com.cleanroommc.component.DataComponentMap.builder();
+            if (this.maxDamage > 0) {
+                builder.set(com.cleanroommc.component.DataComponents.MAX_DAMAGE, this.maxDamage);
+            }
+            builder.set(com.cleanroommc.component.DataComponents.MAX_STACK_SIZE, this.maxStackSize);
+            buildComponents(builder);
+            built = builder.build();
+            this.components = built;
+        }
+        return built;
+    }
