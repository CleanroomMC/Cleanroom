+    /* ======================================== CLEANROOM START =====================================*/
+    private static final int BTT_SORT_BY = 300;
+    private static final int BTT_FILTER_MODE = 301;
+    private static final int BTT_SEARCH_BY = 302;
+    private static final int BTT_LAYOUT = 303;
+
+    private static com.cleanroommc.client.controls.GuiControlsHook.SortMode sortMode = com.cleanroommc.client.controls.GuiControlsHook.SortMode.CATEGORY;
+    private static com.cleanroommc.client.controls.GuiControlsHook.SearchMode searchMode = com.cleanroommc.client.controls.GuiControlsHook.SearchMode.NAME;
+    private static com.cleanroommc.client.controls.GuiControlsHook.FilterMode filterMode = com.cleanroommc.client.controls.GuiControlsHook.FilterMode.DEFAULT;
+
+    private GuiTextField search;
+
+    private void cleanroom$initGui() {
+        sortMode   = com.cleanroommc.client.controls.GuiControlsHook.SortMode.CATEGORY;
+        searchMode = com.cleanroommc.client.controls.GuiControlsHook.SearchMode.NAME;
+        filterMode = com.cleanroommc.client.controls.GuiControlsHook.FilterMode.DEFAULT;
+
+        search = new GuiTextField(0, fontRenderer, this.width / 2 - 239, this.height - 50, 232, 20);
+
+        buttonList.add(new GuiButton(BTT_SORT_BY, this.width / 2 - 155 + 160, this.height - 71, 115, 20, sortMode.translateText()));
+        buttonList.add(new GuiButton(BTT_FILTER_MODE, this.width / 2 - 155 + 281, this.height - 71, 115, 20, filterMode.translateText()));
+        buttonList.add(new GuiButton(BTT_SEARCH_BY, this.width / 2 - 155 + 160, this.height - 50, 115, 20, searchMode.translateText()));
+        buttonList.add(new GuiButton(BTT_LAYOUT, this.width / 2 - 155 + 281, this.height - 50, 115, 20, I18n.format(com.cleanroommc.client.controls.GuiControlsHook.TRANSLATE_LAYOUT)));
+    }
+
+    private boolean cleanroom$keyTyped(char typedChar, int keyCode) {
+        String previousSearch = search.getText();
+        if (search.textboxKeyTyped(typedChar, keyCode) && !previousSearch.equals(search.getText())) {
+            this.keyBindingList.cleanroom$updateList();
+            return true;
+        }
+        return false;
+    }
+
+    public static com.cleanroommc.client.controls.GuiControlsHook.SortMode sortMode() {
+        return sortMode;
+    }
+
+    public static com.cleanroommc.client.controls.GuiControlsHook.SearchMode searchMode() {
+        return searchMode;
+    }
+
+    public static com.cleanroommc.client.controls.GuiControlsHook.FilterMode filterMode() {
+        return filterMode;
+    }
+
+    public String currentSearch() {
+        return search.getText();
+    }
+
+    private boolean cleanroom$actionPerformed(GuiButton button) {
+        boolean success = true;
+        switch (button.id) {
+            case BTT_SORT_BY -> sortMode = sortMode.next(button);
+            case BTT_FILTER_MODE -> filterMode = filterMode.next(button);
+            case BTT_SEARCH_BY -> searchMode = searchMode.next(button);
+            case BTT_LAYOUT -> {
+
+            }
+            default -> success = false;
+        }
+        return success;
+    }
