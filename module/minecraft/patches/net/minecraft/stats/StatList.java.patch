+    @Nullable
+    private static StatBase statAt(StatBase[] stats, int id) {
+        return id >= 0 && id < stats.length ? stats[id] : null;
+    }
+
+    /** Cleanroom: one slot per block/item id the registries use; the arrays must be empty (init, reinit). */
+    private static void sizeArrays() {
+        int blocks = 4096;
+        for (Block block : Block.REGISTRY) {
+            blocks = Math.max(blocks, Block.getIdFromBlock(block) + 1);
+        }
+        int items = 32000;
+        for (Item item : Item.REGISTRY) {
+            items = Math.max(items, Item.getIdFromItem(item) + 1);
+        }
+        if (BLOCKS_STATS.length < blocks) {
+            BLOCKS_STATS = new StatBase[blocks];
+        }
+        if (CRAFTS_STATS.length < items) {
+            CRAFTS_STATS = new StatBase[items];
+            OBJECT_USE_STATS = new StatBase[items];
+            OBJECT_BREAK_STATS = new StatBase[items];
+            OBJECTS_PICKED_UP_STATS = new StatBase[items];
+            OBJECTS_DROPPED_STATS = new StatBase[items];
+        }
+    }
